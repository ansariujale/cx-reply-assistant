# ---------------------------------------------------------------------------
# LLM provider (OpenRouter, OpenAI-compatible API)
# If OPENROUTER_API_KEY is empty the app falls back to a deterministic MOCK
# LLM so the full UI loop can be exercised locally with zero credentials.
# The mock is clearly labelled in the UI and must not be used in production.
# ---------------------------------------------------------------------------
OPENROUTER_API_KEY=
# With credit on the OpenRouter account, openai/gpt-4o-mini is a good default.
# Without credit, paid models are refused outright (even with free fallbacks),
# so use a free model as the primary, for example:
#   OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free
# Free models have a daily request cap but work fine for a demo.
OPENROUTER_MODEL=openai/gpt-4o-mini
# Comma-separated list tried in order if the primary model/provider fails
# (OpenRouter allows at most two fallbacks).
OPENROUTER_FALLBACK_MODELS=google/gemini-2.5-flash-lite

# ---------------------------------------------------------------------------
# Database (PostgreSQL / Supabase)
# If DATABASE_URL is empty the app uses an IN-MEMORY store seeded with demo
# data. Fine for local dev and tests; state resets on restart and is per
# serverless instance, so always set DATABASE_URL for a deployment.
#
# Supabase: Project Settings -> Database -> Connection string -> "Transaction"
# pooler (port 6543). Keep ?sslmode=require on hosted databases.
# ---------------------------------------------------------------------------
DATABASE_URL=
# DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?sslmode=require

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
# Used for OpenRouter attribution headers and absolute links.
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Max AI generations per IP per minute on the public endpoint (abuse guard).
GENERATE_RATE_LIMIT_PER_MINUTE=10
